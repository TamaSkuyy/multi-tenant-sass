out/

# Production builds
build/
dist/

# Prisma
prisma/*.db
prisma/*.db-journal
# Binding project/branch lokal yang ditulis Prisma CLI (.prisma/local.json)
.prisma/
# Skill agent Prisma — di-generate ulang oleh `prisma skills sync` (postinstall)
# `**/` perlu karena pola berslash di-anchor ke root repo oleh git
**/.agents/skills/
**/.claude/skills/
**/.cursor/skills/
**/.devin/skills/

# Backup database (deploy-production.sh --backup) — berisi data, jangan di-commit
backups/

