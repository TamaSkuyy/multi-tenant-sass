# Salin file ini menjadi `.env` lalu sesuaikan bila perlu.
# `./develop.sh` akan menyalinnya otomatis kalau `.env` belum ada.
#
# Nilai default di bawah SAMA dengan default di docker-compose.yml,
# jadi `docker compose up -d` + `npm run seed` langsung nyambung.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/multi_tenant_sass"

# Port HTTP server Express. Client Next.js (../client) memanggil 8080,
# jadi samakan dengan NEXT_PUBLIC_API_URL di client/.env.local.
PORT=8080

# CORS whitelist (dipisah koma). `*` = satu label host, sehingga
# http://*.localhost:3000 mencakup subdomain tenant (budi.localhost:3000).
# Di produksi tambahkan domain asli, mis. https://example.com,https://*.example.com
CLIENT_ORIGINS="http://localhost:3000,http://*.localhost:3000"

# Rahasia bersama API ↔ BFF Next (menandatangani identitas user lewat HMAC).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Nilainya harus SAMA dengan INTERNAL_API_SECRET di client/.env.local
INTERNAL_API_SECRET="ganti-dengan-random-min-16-karakter"

# Untuk produksi: JANGAN pakai file ini, set DATABASE_URL langsung dari
# environment/secret manager lalu jalankan ./deploy-production.sh
