# Salin file ini menjadi `.env.local` (atau biarkan `./develop.sh` membuatnya).
#
# Dipakai oleh:
#   - Browser (client component)  → NEXT_PUBLIC_API_URL (di-inline saat build)
#   - Server-side rendering/BFF   → API_URL (fallback ke NEXT_PUBLIC_API_URL)
#
# Samakan port-nya dengan PORT di ../api/.env
NEXT_PUBLIC_API_URL="http://localhost:8080"
API_URL="http://localhost:8080"

# Rahasia sesi NextAuth. Generate sendiri:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="ganti-dengan-random-32-byte-base64url"

# Rahasia bersama BFF ↔ API (HMAC identitas user).
# HARUS sama persis dengan INTERNAL_API_SECRET di ../api/.env
INTERNAL_API_SECRET="ganti-dengan-random-min-16-karakter"
